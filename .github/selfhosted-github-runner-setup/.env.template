# GitHub repository URL
# Get from: GitHub Repository -> Code -> HTTPS
GITHUB_URL=https://github.com/<USERNAME>/<REPOSITORY>

# GitHub Personal Access Token (PAT)
# Used only at container startup/shutdown to automatically request a
# short-lived runner registration/removal token via the GitHub REST API.
# It is never written to disk and is discarded from the shell as soon
# as it has been used.
#
# How to generate a Fine-grained PAT (recommended):
#   1. GitHub -> click your profile photo -> Settings
#   2. Developer settings -> Personal access tokens -> Fine-grained tokens
#   3. Click "Generate new token"
#   4. Resource owner: your account (e.g. ayushsarvaiya5)
#   5. Repository access: "Only select repositories" -> choose this repository
#   6. Permissions -> Repository permissions -> Administration: set to "Read and write"
#      (this is what lets it manage self-hosted runners)
#   7. Set an expiration, click "Generate token"
#   8. Copy the generated token value into GITHUB_PAT below
#
# Alternative - Classic PAT:
#   GitHub -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
#   -> Generate new token -> check scope "repo" (or "admin:org" for organization runners)
#   Note: classic PAT scope "repo" grants access to ALL your repositories, not just this one.

GITHUB_PAT=<YOUR_PERSONAL_ACCESS_TOKEN>         # Use a fine-grained PAT.

# Runner name
# Any unique name you want
RUNNER_NAME=GitHubActionsDemo

# Runner labels
# Must match the label used in workflow: runs-on
RUNNER_LABELS=self-hosted,Linux,X64,GitHubActionsDemo-runner

# GitHub Actions runner version
# Check: https://github.com/actions/runner/releases
RUNNER_VERSION=2.338.0

# Runner architecture
RUNNER_ARCH=x64

# Runner working directory
RUNNER_WORK_FOLDER=_work
